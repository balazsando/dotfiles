set hidden
set ignorecase
set icons
set number
set preview
set relativenumber

set previewer ~/.config/lf/previewer

cmd unarchive ${{
  case "$f" in
      *.zip) unzip "$f" ;;
      *.rar) unrar x "$f" ;;
      *.tar.gz) tar -xzvf "$f" ;;
      *.tar.bz2) tar -xjvf "$f" ;;
      *.tar) tar -xvf "$f" ;;
      *.7z) 7z e "$f" ;;
      *) echo "Unsupported format" ;;
  esac
}}

cmd open ${{
  case "$f" in
      *.pdf) $EDITOR "$f" ;;
      *) ${OPENER:-xdg-open} "$f" ;;
  esac
}}

cmd mkdir ${{
  printf "Directory Name: "
  read ans
  mkdir $ans
}}

cmd mkfile ${{
  printf "File Name: "
  read ans
  $EDITOR $ans
}}

cmd wincd &lf -remote "send $id cd \"/mnt/c/Users/$WIN_USER/$1\""

cmd reloc ${{
  zsh -ic 'relocate "$1"' _ "$f"
}}

map R reloc
map au unarchive
map gr cd ~/repos
map gv wincd Videos
map gc cd ~/.config
map gD wincd Documents
map gd wincd Downloads
map gp wincd Pictures
map gH wincd
map mf mkfile
map md mkdir
map i $~/.config/lf/previewer "$f" "$(tput cols)" "$(tput lines)" | less -RS
