{
  "mcpServers": {
    "sonarqube": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--yes",
        "sonarqube-mcp-server@1.10.21"
      ],
      "env": {
        "SONARQUBE_URL": "${SONARQUBE_URL}",
        "SONARQUBE_TOKEN": "${SONARQUBE_TOKEN}",
        "NODE_EXTRA_CA_CERTS": "${NODE_EXTRA_CA_CERTS}"
      }
    },
    "jira": {
      "type": "stdio",
      "command": "${HOME}/.local/share/dotfiles/scripts/jira-mcp.sh",
      "env": {
        "JIRA_EMAIL": "${JIRA_EMAIL}",
        "JIRA_TOKEN": "${JIRA_TOKEN}",
        "JIRA_URL": "${JIRA_URL}"
      }
    },
    "gitlab": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@zereight/mcp-gitlab"
      ],
      "env": {
        "GITLAB_PERSONAL_ACCESS_TOKEN": "${GITLAB_TOKEN}",
        "GITLAB_API_URL": "${GITLAB_API_URL}",
        "GITLAB_READ_ONLY_MODE": "false",
        "NODE_EXTRA_CA_CERTS": "${NODE_EXTRA_CA_CERTS}",
        "GITLAB_TOOLSETS": "core,merge_requests,pipelines,variables,webhooks,users"
      }
    },
    "postman": {
      "type": "http",
      "url": "https://mcp.postman.com/mcp",
      "headers": {
        "Authorization": "Bearer ${POSTMAN_API_KEY}"
      }
    },
    "grafana": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-grafana"
      ],
      "env": {
        "GRAFANA_URL": "${GRAFANA_URL}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_MCP_TOKEN}"
      }
    },
    "grafana-prep": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-grafana"
      ],
      "env": {
        "GRAFANA_URL": "${GRAFANA_URL_PREP}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_MCP_TOKEN_PREP}"
      }
    },
    "grafana-prep-connector": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-grafana"
      ],
      "env": {
        "GRAFANA_URL": "${GRAFANA_URL_PREPC}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_MCP_TOKEN_PREPC}"
      }
    },
    "grafana-prod": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-grafana"
      ],
      "env": {
        "GRAFANA_URL": "${GRAFANA_URL_PROD}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_MCP_TOKEN_PROD}"
      }
    },
    "grafana-prod-connector": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-grafana"
      ],
      "env": {
        "GRAFANA_URL": "${GRAFANA_URL_PRODC}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_MCP_TOKEN_PRODC}"
      }
    }
  }
}
