{
  "mcpServers": {
    "sonarqube": {
      "command": "npx",
      "args": [
        "--yes",
        "sonarqube-mcp-server@1.10.21"
      ],
      "env": {
        "SONARQUBE_URL": "${env:SONARQUBE_URL}",
        "SONARQUBE_TOKEN": "${env:SONARQUBE_TOKEN}",
        "NODE_EXTRA_CA_CERTS": "${env:NODE_EXTRA_CA_CERTS}"
      }
    },
    "jira": {
      "command": "${env:HOME}/.local/share/dotfiles/scripts/jira-mcp.sh",
      "env": {
        "JIRA_EMAIL": "${env:JIRA_EMAIL}",
        "JIRA_TOKEN": "${env:JIRA_TOKEN}",
        "JIRA_URL": "${env:JIRA_URL}"
      }
    },
    "gitlab": {
      "command": "npx",
      "args": [
        "-y",
        "@zereight/mcp-gitlab"
      ],
      "env": {
        "GITLAB_PERSONAL_ACCESS_TOKEN": "${env:GITLAB_TOKEN}",
        "GITLAB_API_URL": "${env:GITLAB_API_URL}",
        "GITLAB_READ_ONLY_MODE": "false",
        "NODE_EXTRA_CA_CERTS": "${env:NODE_EXTRA_CA_CERTS}",
        "GITLAB_TOOLSETS": "core,merge_requests,pipelines,variables,webhooks,users"
      }
    },
    "postman": {
      "type": "http",
      "url": "https://mcp.postman.com/mcp",
      "headers": {
        "Authorization": "Bearer ${env:POSTMAN_API_KEY}"
      }
    },
    "grafana": {
      "command": "uvx",
      "args": [
        "mcp-grafana"
      ],
      "env": {
        "GRAFANA_URL": "${env:GRAFANA_URL}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${env:GRAFANA_MCP_TOKEN}"
      }
    },
    "grafana-prep": {
      "command": "uvx",
      "args": [
        "mcp-grafana"
      ],
      "env": {
        "GRAFANA_URL": "${env:GRAFANA_URL_PREP}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${env:GRAFANA_MCP_TOKEN_PREP}"
      }
    },
    "grafana-prep-connector": {
      "command": "uvx",
      "args": [
        "mcp-grafana"
      ],
      "env": {
        "GRAFANA_URL": "${env:GRAFANA_URL_PREPC}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${env:GRAFANA_MCP_TOKEN_PREPC}"
      }
    },
    "grafana-prod": {
      "command": "uvx",
      "args": [
        "mcp-grafana"
      ],
      "env": {
        "GRAFANA_URL": "${env:GRAFANA_URL_PROD}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${env:GRAFANA_MCP_TOKEN_PROD}"
      }
    },
    "grafana-prod-connector": {
      "command": "uvx",
      "args": [
        "mcp-grafana"
      ],
      "env": {
        "GRAFANA_URL": "${env:GRAFANA_URL_PRODC}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${env:GRAFANA_MCP_TOKEN_PRODC}"
      }
    },
    "serena": {
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context",
        "ide",
        "--project-from-cwd",
        "--open-web-dashboard",
        "false"
      ],
      "env": {
        "PATH": "${env:HOME}/.sdkman/candidates/java/current/bin:${env:PATH}",
        "JAVA_HOME": "${env:HOME}/.sdkman/candidates/java/current"
      }
    }
  }
}
