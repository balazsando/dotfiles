#!/bin/sh
#
# prepare-commit-msg hook — auto-format Git commit messages
# Works on Windows (Git Bash), macOS, and Linux

commit_msg_file="$1"
commit_source="$2"

# --- Skip auto-generated commit messages ---
case "$commit_source" in
  merge|squash|commit|template)
    exit 0
    ;;
esac

# --- Drop machine-generated attribution ---
# Bot co-author trailers, tool session links, and "Generated with" footers.
# Must run before the message is read below, or it gets written back.
sed -i -E '/^Co-[Aa]uthored-[Bb]y:.*<[^>]*noreply@[^>]*>[[:space:]]*$/d;
           /^[A-Za-z][A-Za-z-]*-Session:[[:space:]]*http/d;
           /Generated with \[/d' "$commit_msg_file"
printf '%s\n' "$(cat "$commit_msg_file")" > "$commit_msg_file"

# --- Read current commit message ---
# Subject only — matching the whole message meant a trailer line such as
# "Signed-off-by:" was read as {type}-{msg} and mangled the body.
message="$(head -n 1 "$commit_msg_file" | tr -d '\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
body="$(tail -n +2 "$commit_msg_file")"

# --- Skip known autogenerated commit messages ---
if echo "$message" | grep -qE '^(Merge |Revert |fixup! |squash! )'; then
  exit 0
fi

# --- Get current branch name ---
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

# --- Extract ticket (e.g. PROJ-1234) ---
# Hooks never source the shell profile. Read only this one value, not the
# whole secrets file.
if [ -z "${JIRA_PROJECT_KEY:-}" ] && [ -r "$HOME/.config/zsh/secrets" ]; then
  JIRA_PROJECT_KEY=$(sed -n 's/^[[:space:]]*export[[:space:]]*JIRA_PROJECT_KEY=//p' \
    "$HOME/.config/zsh/secrets" 2>/dev/null | tr -d "\"'" | head -1)
fi

ticket=$(echo "$branch" | grep -Eo "${JIRA_PROJECT_KEY:-[A-Z][A-Z0-9]+}-[0-9]+" || echo "")

# --- Emoji map ---
get_emoji() {
  case "$1" in
    feat) echo "✨" ;;
    fix) echo "🐛" ;;
    docs) echo "📝" ;;
    chore) echo "🧹" ;;
    refactor) echo "♻️" ;;
    style) echo "🎨" ;;
    test) echo "✅" ;;
    deploy) echo "🚀" ;;
    typo) echo "🔤" ;;
    revert) echo "⏪" ;;
    version) echo "⬆️" ;;
    *) echo "" ;;
  esac
}

# --- Only transform messages that match {type}-{msg} ---
if echo "$message" | grep -qE '^[a-zA-Z]+-.+'; then
  type=$(echo "$message" | sed -E 's/^([a-zA-Z]+)-.*/\1/' | tr '[:upper:]' '[:lower:]')
  title=$(echo "$message" | sed -E 's/^[a-zA-Z]+-(.*)/\1/')

  # --- Capitalize first letter of title ---
  first_char=$(printf '%s' "$title" | cut -c1 | tr '[:lower:]' '[:upper:]')
  rest=$(printf '%s' "$title" | cut -c2-)
  title="$first_char$rest"

  # --- Build final commit message ---
  emoji=$(get_emoji "$type")
  if [ -n "$ticket" ]; then
    final_msg="$ticket $emoji ($type): $title"
  else
    final_msg="$emoji ($type): $title"
  fi

  # --- Overwrite the subject, keep the body intact ---
  { echo "$final_msg"; [ -n "$body" ] && printf '%s\n' "$body"; } > "$commit_msg_file"
fi

# The block above ends in an && list that is false when the body is empty, and
# git aborts the commit on a non-zero prepare-commit-msg. Exit explicitly.
exit 0