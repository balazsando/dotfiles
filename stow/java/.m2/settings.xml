
<settings xmlns="http://maven.apache.org/SETTINGS/1.1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.1.0 http://maven.apache.org/xsd/settings-1.1.0.xsd">
    <servers>
        <server>
            <id>central</id>
            <username>${env.NEXUS_USERNAME}</username>
            <password>${env.NEXUS_PASSWORD}</password>
        </server>
        <!-- Docker registry auth — the id must equal the registry hostname. -->
        <server>
            <id>${env.NEXUS_SERVER_ID}</id>
            <username>${env.NEXUS_USERNAME}</username>
            <password>${env.NEXUS_PASSWORD}</password>
        </server>
        <server>
            <id>nexus-snapshots</id>
            <username>${env.NEXUS_USERNAME}</username>
            <password>${env.NEXUS_PASSWORD}</password>
        </server>
        <server>
            <id>nexus-releases</id>
            <username>${env.NEXUS_USERNAME}</username>
            <password>${env.NEXUS_PASSWORD}</password>
        </server>
    </servers>
    <mirrors>
        <mirror>
            <id>central</id>
            <name>central</name>
            <url>${env.NEXUS_BASE_URL}/repository/maven-group/</url>
            <mirrorOf>*</mirrorOf>
        </mirror>
        <mirror>
            <id>mvn-repo-jasper-unblocker-mirror</id>
            <mirrorOf>nexus-repo-jasper</mirrorOf>
            <name></name>
            <url>${env.NEXUS_BASE_URL}/repository/maven-jaspersoft</url>
        </mirror>
    </mirrors>

    <profiles>
        <profile>
            <repositories>
                <repository>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                    <id>nexus-repo-release</id>
                    <name>maven-releases</name>
                    <url>${env.NEXUS_BASE_URL}/repository/maven-releases/</url>
                </repository>

                <repository>
                    <snapshots/>
                    <id>nexus-repo-snapshot</id>
                    <name>maven-snapshots</name>
                    <url>${env.NEXUS_BASE_URL}/repository/maven-snapshots/</url>
                </repository>
            </repositories>
            <id>nexus</id>
        </profile>
    </profiles>

    <activeProfiles>
        <activeProfile>nexus</activeProfile>
    </activeProfiles>

</settings>